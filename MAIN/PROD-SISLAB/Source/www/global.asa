	    Application("SISLAB_ID_CODARQTIPO_MANUALGESTAO") = 9
	    Application("SISLAB_ID_CODARQTIPO_CODIGOETICA") = 34
	    Application("SISLAB_ID_CODARQTIPO_CONHECENDOCRT") = 35
	    Application("SISLAB_ID_CODARQTIPO_RECURSOSDISPONIVEISCRT") = 36
	    Application("SISLAB_ID_CODARQTIPO_VIDEOS") = 37
	    Application("SISLAB_ID_SITUACAOARQUIVO_APROVADO") = 2

		'Application("SISLAB_ServidorLocalCRT") = "http://localhost/sislab1_arquivoslocais/"
