	End If

	Application("SISLAB_Tempo_Troca_Imagens") = 10

	Application("SISLAB_FolderArquivos") = "\Arquivos"
	Application("SISLAB_FolderArquivosLB") = "\ArquivosLB"

	'Application("SISLAB_DEBUG") = "SIM"		'-- SIM / NAO
